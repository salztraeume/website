---
import BaseLayout from './BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import ApartmentFeatures from '../components/ApartmentFeatures.astro';

interface Props {
  name: string;
  slug: string;
  tagline: string;
  description: string;
  size: string;
  guests: string;
  bedrooms: string;
  bathrooms: string;
  checkIn: string;
  checkOut: string;
  images: { src: string; alt: string }[];
  features: string[];
  highlights: string[];
  heroImage: string;
}

const {
  name, slug, tagline, description, size, guests, bedrooms, bathrooms,
  checkIn, checkOut, images, features, highlights, heroImage
} = Astro.props;
---

<BaseLayout title={`Ferienwohnung ${name}`} description={`Ferienwohnung ${name} — ${tagline}. ${size}, ${guests}.`} bodyClass="page-light">
  <!-- Hero -->
  <section class="pt-28 lg:pt-36 pb-12 section-padding bg-cream-50">
    <div class="content-width">
      <a href="/#wohnungen" class="inline-flex items-center gap-2 text-body-sm text-charcoal-400 hover:text-salt-600 transition-colors duration-200 mb-8">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
        </svg>
        Alle Wohnungen
      </a>
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <div class="flex items-center gap-5 mb-6">
            <div class="aspect-square w-20 sm:w-24 rounded-xl overflow-hidden shadow-warm flex-shrink-0">
              <img
                src={`/img/${slug}.webp`}
                alt={`Ferienwohnung ${name}`}
              />
            </div>
            <div class="min-w-0 flex flex-col justify-center">
              <h1 class="text-h1 font-heading text-charcoal-900 mb-3">{name}</h1>
              <p class="font-heading text-xl italic text-salt-500">{tagline}</p>
            </div>
          </div>
          <p class="text-body text-charcoal-500 mb-8 leading-relaxed">{description}</p>

          <!-- Quick Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
            <div class="bg-white rounded-xl p-4 text-center shadow-warm">
              <p class="font-heading text-2xl font-semibold text-charcoal-800">{size}</p>
              <p class="text-caption text-charcoal-400 mt-1">Wohnfläche</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-warm">
              <p class="font-heading text-2xl font-semibold text-charcoal-800">{guests}</p>
              <p class="text-caption text-charcoal-400 mt-1">Gäste</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-warm">
              <p class="font-heading text-2xl font-semibold text-charcoal-800">{bedrooms}</p>
              <p class="text-caption text-charcoal-400 mt-1">Schlafzimmer</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-warm">
              <p class="font-heading text-2xl font-semibold text-charcoal-800">{bathrooms}</p>
              <p class="text-caption text-charcoal-400 mt-1">Badezimmer</p>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/buchen/" class="btn-primary" data-apt-price-btn={slug}>
              Ab … / Nacht buchen
            </a>
            <a href="/preise/" class="btn-secondary text-sm">
              Alle Preise ansehen
            </a>
          </div>
        </div>
        <div>
          <Gallery images={images} />
        </div>
      </div>
    </div>
  </section>

  <!-- Salt Highlight -->
  <section class="section-padding py-16 bg-gradient-to-r from-salt-50 to-cream-100">
    <div class="content-width">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class="w-16 h-16 flex-shrink-0 rounded-2xl bg-salt-200/50 flex items-center justify-center">
          <svg class="w-8 h-8 text-salt-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-xl font-semibold text-charcoal-800 mb-2">Himalayasalz-Atmosphäre</h3>
          <p class="text-body text-charcoal-500">
            Die Salzelemente in dieser Wohnung schaffen eine mineralsalzhaltige Luft, ähnlich wie
            in einem Salzstollen oder an der Meeresküste — natürlich und wohltuend.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features & Highlights -->
  <section class="section-padding py-20 bg-white">
    <div class="content-width">
      <div class="grid lg:grid-cols-2 gap-16">
        <div>
          <h2 class="text-h3 font-heading text-charcoal-900 mb-6">Ausstattung</h2>
          <ApartmentFeatures features={features} />
        </div>
        <div>
          <h2 class="text-h3 font-heading text-charcoal-900 mb-6">Besonderheiten</h2>
          <ul class="space-y-4">
            {highlights.map((h) => (
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-salt-500 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                </svg>
                <span class="text-body text-charcoal-600">{h}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Check-in/out Info -->
  <section class="section-padding py-12 bg-cream-50 border-t border-cream-200">
    <div class="content-width">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-8">
          <div>
            <p class="text-caption text-charcoal-400 uppercase tracking-wider">Check-in</p>
            <p class="font-heading text-xl font-semibold text-charcoal-800">{checkIn}</p>
          </div>
          <div class="w-px h-10 bg-cream-300"></div>
          <div>
            <p class="text-caption text-charcoal-400 uppercase tracking-wider">Check-out</p>
            <p class="font-heading text-xl font-semibold text-charcoal-800">{checkOut}</p>
          </div>
          <div class="w-px h-10 bg-cream-300"></div>
          <div>
            <p class="text-caption text-charcoal-400 uppercase tracking-wider">Mindestaufenthalt</p>
            <p class="font-heading text-xl font-semibold text-charcoal-800">2 Nächte</p>
          </div>
        </div>
        <a href="/buchen/" class="btn-primary text-sm">Verfügbarkeit prüfen</a>
      </div>
    </div>
  </section>

  <slot />
</BaseLayout>

<script>
  import { fetchRules, SLUG_TO_CODE } from '../lib/pricing';

  fetchRules().then(rules => {
    document.querySelectorAll<HTMLElement>('[data-apt-price-btn]').forEach(el => {
      const slug = el.dataset.aptPriceBtn!;
      const code = SLUG_TO_CODE[slug];
      if (!code) return;
      const neben = rules.saisons.find(s => s.name === 'Nebensaison');
      if (neben) el.textContent = `Ab ${neben.price[code]} € / Nacht buchen`;
    });
  });
</script>
