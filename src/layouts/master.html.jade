doctype
html(lang='en')
  head
      meta(charset='utf-8')
      meta(http-equiv='X-UA-Compatible', content='IE=edge')
      meta(name='viewport', content='width=device-width, initial-scale=1')
      meta(name='description', content=locals.description)
      meta(name='keywords', content=locals.keywords)
      title=locals.title
      link#favicon(rel="shortcut icon", type="image/png", href="")
      link(href='/styles/all.css', rel='stylesheet', type='text/css', charset='utf-8')
      <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
      <!--[if lt IE 9]>
      <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
      <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
      <![endif]-->
  body
    nav.navbar.navbar-default.navbar-fixed-top
      div.container
        div.navbar-header
          button.navbar-toggle.collapsed(type="button" class="" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-controls="navbar")
            span.sr-only Navigation umschalten
            span.icon-bar
            span.icon-bar
            span.icon-bar
          a.navbar-brand.logo(href="/")

        div#navbar(class="collapse navbar-collapse")
          ul.nav.navbar-nav
            //- li: a(href="konzept.html") Konzept
            li.dropdown
              a(href="#", class="dropdown-toggle", data-toggle="dropdown", role="button", aria-expanded="false")
                | Wohnen
                span.caret
              ul.dropdown-menu(role="menu")
                li.dropdown-header Ferienwohnungen
                li: a(href="/ferienwohnung-schmetterling.html") Schmetterling
                li: a(href="/ferienwohnung-eichhoernchen.html") Eichhörnchen
                li: a(href="/ferienwohnung-fuchs.html") Fuchs
                li: a(href="/ferienwohnung-schwan.html") Schwan
                li.divider
                li: a(href="/preise.html") Preise
                li: a(href="/buchen.html") Buchen

            //- li.dropdown
            //-   a(href="#", class="dropdown-toggle", data-toggle="dropdown", role="button", aria-expanded="false")
            //-     | Aktionen
            //-     span.caret
            //-   ul.dropdown-menu(role="menu")
            //-     li: a(href="angebot.html") Eröffnungsangebot
            //-     li: a(href="geocache.html") Geocache

            li: a(href='/see-und-saarow.html') See&amp;Saarow
            li: a(href='/tagungsraum.html') Tagungsraum
            li.dropdown
              a(href="#", class="dropdown-toggle", data-toggle="dropdown", role="button", aria-expanded="false")
                | Veranstaltungen
                span.caret
              ul.dropdown-menu(role="menu")
                li: a(href="/will-czuch.html") Wohnzimmerkonzert
                //-li: a(href="/yoga-live-breathe.html") Yoga

          ul.nav.navbar-nav.navbar-right
            li: a(href="/buchen.html") Buchen

    .container.main-content!=locals.mainContent

    footer.footer
      div.container
        ul.pull-right
          //-li: a(href='kontakt.html') Kontakt
          li: a(href='/anreiseinfos.html') ANREISEINFOS
          li: a(href='/kontakt.html') KONTAKT
          li: a(href='/impressum.html') IMPRESSUM
          li: a(href='/datenschutz.html') DATENSCHUTZ

    script(src='/js/scripts.js')
    if locals.scripts
      - scriptFiles = locals.scripts.split(',')
      each script in scriptFiles
        script(src=script)

    <!--[if lte IE 9]>
    <link href='styles/ie.css' rel='stylesheet' type='text/css' charset='utf-8'></link>
    <![endif]-->
    if process.env.OFFLINE == null
      script.
        //var $buoop = {c:2};function $buo_f(){var e = document.createElement("script");e.src = "//browser-update.org/update.js";document.body.appendChild(e);};try {document.addEventListener("DOMContentLoaded", $buo_f,false)}catch(e){window.attachEvent("onload", $buo_f)}
      script.
        var _paq = _paq || [];
        /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function() {
          var u="//matomo.thunderwave.de/";
          _paq.push(['setTrackerUrl', u+'piwik.php']);
          _paq.push(['setSiteId', '4']);
          var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
          g.type='text/javascript'; g.async=true; g.defer=true; g.src=u+'piwik.js'; s.parentNode.insertBefore(g,s);
        })();
