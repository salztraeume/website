---
interface Props {
  name: string;
  slug: string;
  image: string;
  size: string;
  guests: string;
  tagline: string;
  index?: number;
}

const { name, slug, size, guests, tagline, index = 0 } = Astro.props;

const ANIMAL_ICONS: Record<string, string> = {
  schmetterling:
    'M12 21c-.6 0-1-.4-1-1V9.5C8.5 12 5.5 13 3.5 13 2.1 13 1 11.9 1 10.5 1 7.5 3.5 5 6.5 5c2 0 4 1.2 5.5 3.2C13.5 6.2 15.5 5 17.5 5 20.5 5 23 7.5 23 10.5c0 1.4-1.1 2.5-2.5 2.5-2 0-5-1-7.5-3.5V20c0 .6-.4 1-1 1z',
  eichhoernchen:
    'M14 3c-2.2 0-4 1.8-4 4 0 .7.2 1.4.5 2C8.5 9.8 7 12 7 14.5c0 1.4.5 2.7 1.4 3.7L6 21h10c2.2 0 4-1.8 4-4 0-1.5-.8-2.8-2-3.5.6-.9 1-2 1-3.2 0-1.6-.6-3.1-1.6-4.2C18.5 5 17 3 14 3zm.5 4.5a1 1 0 110 2 1 1 0 010-2z',
  fuchs:
    'M3 4l4 3 5-1 5 1 4-3-1 7c0 4.5-3.5 9-8 9s-8-4.5-8-9L3 4zm6 8a1 1 0 110 2 1 1 0 010-2zm6 0a1 1 0 110 2 1 1 0 010-2zm-3 3l-1.5 2h3L12 15z',
  schwan:
    'M5 19c0-5.5 3.5-10 8-10 1.7 0 3 .5 4 1.3V8c0-2.2 1.3-3.5 3-3.5.6 0 1 .2 1.5.5-.5.3-1 .8-1 1.5 0 .8.7 1.5 1.5 1.5.5 0 .9-.2 1.2-.5C23 8.5 22 11 19 11c-1 4.5-5 8-10 8H5v-1l1-1c-.6-.3-1-1-1-2v1z',
};

const iconPath = ANIMAL_ICONS[slug] ?? '';
---

<a
  href={`/ferienwohnungen/${slug}/`}
  class:list={[
    'card group block reveal',
    `reveal-delay-${index + 1}`
  ]}
>
  <div class="relative overflow-hidden aspect-[4/3] bg-salt-100 flex items-center justify-center">
    <svg
      class="w-1/2 h-1/2 text-salt-500 transition-transform duration-700 group-hover:scale-110"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-label={`Icon ${name}`}
      role="img"
    >
      <path d={iconPath} />
    </svg>
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal-900/30 via-transparent to-transparent"></div>
    <div class="absolute bottom-4 left-5 right-5">
      <span class="font-heading text-2xl font-semibold text-charcoal-800">{name}</span>
    </div>
  </div>
  <div class="p-6">
    <p class="text-body-sm text-charcoal-500 mb-4 italic font-heading text-lg">{tagline}</p>
    <div class="flex items-center gap-4 text-body-sm text-charcoal-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
        </svg>
        {size}
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
        {guests}
      </span>
    </div>
    <div class="mt-5 pt-5 border-t border-cream-200 flex items-center justify-between">
      <span class="text-body-sm text-charcoal-400">
        ab <span class="text-h4 font-heading font-semibold text-salt-600" data-apt-price={slug}>…</span> / Nacht
      </span>
      <span class="text-salt-500 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all duration-300">
        Details
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </div>
  </div>
</a>

<script>
  import { fetchRules, SLUG_TO_CODE } from '../lib/pricing';

  fetchRules().then(rules => {
    document.querySelectorAll<HTMLElement>('[data-apt-price]').forEach(el => {
      const slug = el.dataset.aptPrice!;
      const code = SLUG_TO_CODE[slug];
      if (!code) return;
      const neben = rules.saisons.find(s => s.name === 'Nebensaison');
      if (neben) el.textContent = `${neben.price[code]} €`;
    });
  });
</script>
