---
interface Props {
  name: string;
  slug: string;
  image: string;
  size: string;
  guests: string;
  tagline: string;
  index?: number;
}

const { name, slug, image, size, guests, tagline, index = 0 } = Astro.props;

---

<a
  href={`/ferienwohnungen/${slug}/`}
  class:list={[
    'card group block reveal',
    `reveal-delay-${index + 1}`
  ]}
>
  <div class="relative overflow-hidden aspect-[4/4]">
    <img
      src={image}
      alt={`Ferienwohnung ${name}`}
      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
      loading="lazy"
      width="600"
      height="450"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal-900/50 via-transparent to-transparent"></div>
    <div class="absolute bottom-4 left-5 right-5">
      <span class="font-heading text-2xl font-semibold text-white">{name}</span>
    </div>
  </div>
  <div class="p-6">
    <p class="text-body-sm text-charcoal-500 mb-4 italic font-heading text-lg">{tagline}</p>
    <div class="flex items-center gap-4 text-body-sm text-charcoal-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
        </svg>
        {size}
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
        {guests}
      </span>
    </div>
    <div class="mt-5 pt-5 border-t border-cream-200 flex items-center justify-between">
      <span class="text-body-sm text-charcoal-400">
        ab <span class="text-h4 font-heading font-semibold text-salt-600" data-apt-price={slug}>…</span> / Nacht
      </span>
      <span class="text-salt-500 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all duration-300">
        Details
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </span>
    </div>
  </div>
</a>

<script>
  import { fetchRules, SLUG_TO_CODE } from '../lib/pricing';

  fetchRules().then(rules => {
    document.querySelectorAll<HTMLElement>('[data-apt-price]').forEach(el => {
      const slug = el.dataset.aptPrice!;
      const code = SLUG_TO_CODE[slug];
      if (!code) return;
      const neben = rules.saisons.find(s => s.name === 'Nebensaison');
      if (neben) el.textContent = `${neben.price[code]} €`;
    });
  });
</script>
