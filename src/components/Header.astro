---
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Ferienwohnungen', href: '/ferienwohnungen/schmetterling/', children: [
    { label: 'Schmetterling', href: '/ferienwohnungen/schmetterling/' },
    { label: 'Eichhörnchen', href: '/ferienwohnungen/eichhoernchen/' },
    { label: 'Fuchs', href: '/ferienwohnungen/fuchs/' },
    { label: 'Schwan', href: '/ferienwohnungen/schwan/' },
  ]},
  { label: 'Preise', href: '/preise/' },
  { label: 'Bad Saarow', href: '/bad-saarow/' },
  { label: 'Kontakt', href: '/kontakt/' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-500">
  <div class="section-padding">
    <nav class="content-width flex items-center justify-between h-20 lg:h-24">
      <!-- Logo -->
      <a href="/" class="relative z-50 flex items-center gap-3 group" aria-label="Startseite">
        <div class="flex flex-col">
          <span class="font-heading text-xl lg:text-2xl font-semibold tracking-wide transition-colors duration-300 logo-text">
            SALZ›T‹RÄUME
          </span>
          <span class="font-body text-[0.65rem] lg:text-xs tracking-[0.3em] uppercase transition-colors duration-300 logo-sub">
            am See
          </span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'nav-link px-4 py-2 font-body text-sm font-medium tracking-wide rounded-full transition-all duration-300',
                currentPath.startsWith(item.href.replace(/\/$/, ''))
                  ? 'text-salt-600'
                  : 'hover:text-salt-600'
              ]}
            >
              {item.label}
              {item.children && (
                <svg class="inline-block w-3.5 h-3.5 ml-1 transition-transform duration-300 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="absolute top-full left-1/2 -translate-x-1/2 pt-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300">
                <div class="bg-white/95 backdrop-blur-xl rounded-2xl shadow-elevated border border-cream-200 py-3 px-2 min-w-[200px]">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2.5 text-sm font-body rounded-xl transition-all duration-200',
                        currentPath === child.href
                          ? 'text-salt-600 bg-salt-50'
                          : 'text-charcoal-700 hover:text-salt-600 hover:bg-salt-50'
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
        <a href="/buchen/" class="btn-primary ml-4 text-sm py-2.5 px-6">
          Buchen
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden relative z-50 w-10 h-10 flex items-center justify-center cursor-pointer"
        aria-label="Menü öffnen"
        aria-expanded="false"
      >
        <div class="hamburger-lines">
          <span class="hamburger-line block w-6 h-0.5 transition-all duration-300 origin-center"></span>
          <span class="hamburger-line block w-6 h-0.5 transition-all duration-300 origin-center mt-1.5"></span>
          <span class="hamburger-line block w-4 h-0.5 transition-all duration-300 origin-center mt-1.5"></span>
        </div>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 z-40 bg-cream-50/98 backdrop-blur-xl opacity-0 invisible transition-all duration-500 lg:hidden">
    <div class="flex flex-col items-center justify-center min-h-screen px-8 py-24">
      <nav class="flex flex-col items-center gap-2 w-full max-w-sm">
        {navItems.map((item, i) => (
          <div class="w-full text-center">
            <a
              href={item.href}
              class:list={[
                'block py-3 font-heading text-2xl font-medium transition-colors duration-300',
                currentPath.startsWith(item.href.replace(/\/$/, ''))
                  ? 'text-salt-600'
                  : 'text-charcoal-800 hover:text-salt-600'
              ]}
            >
              {item.label}
            </a>
            {item.children && (
              <div class="flex flex-col items-center gap-1 mt-1 mb-2">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'text-sm font-body py-1 transition-colors duration-200',
                      currentPath === child.href
                        ? 'text-salt-500'
                        : 'text-charcoal-400 hover:text-salt-500'
                    ]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
        <a href="/buchen/" class="btn-primary mt-6 w-full text-center">
          Jetzt buchen
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  let isOpen = false;
  let lastScroll = 0;

  function updateHeader() {
    const scrollY = window.scrollY;
    if (!header) return;

    if (scrollY > 80) {
      header.classList.add('header-scrolled');
    } else {
      header.classList.remove('header-scrolled');
    }

    if (scrollY > lastScroll && scrollY > 200 && !isOpen) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }
    lastScroll = scrollY;
  }

  function toggleMenu() {
    isOpen = !isOpen;
    if (!menuBtn || !mobileMenu) return;

    menuBtn.setAttribute('aria-expanded', String(isOpen));

    if (isOpen) {
      mobileMenu.classList.remove('opacity-0', 'invisible');
      mobileMenu.classList.add('opacity-100', 'visible');
      document.body.style.overflow = 'hidden';
    } else {
      mobileMenu.classList.add('opacity-0', 'invisible');
      mobileMenu.classList.remove('opacity-100', 'visible');
      document.body.style.overflow = '';
    }
  }

  menuBtn?.addEventListener('click', toggleMenu);
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();
</script>

<style>
  #site-header {
    background: transparent;
  }

  #site-header .logo-text,
  #site-header .logo-sub,
  #site-header .nav-link {
    color: white;
    text-shadow: 0 1px 3px rgba(0,0,0,0.3);
  }

  #site-header .hamburger-line {
    background-color: white;
  }

  #site-header.header-scrolled {
    background: rgba(254, 253, 251, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow: 0 1px 20px rgba(0,0,0,0.06);
  }

  #site-header.header-scrolled .logo-text,
  #site-header.header-scrolled .logo-sub,
  #site-header.header-scrolled .nav-link {
    color: #2C2825;
    text-shadow: none;
  }

  #site-header.header-scrolled .hamburger-line {
    background-color: #2C2825;
  }

  #site-header.header-scrolled .nav-link:hover {
    color: #C4875B;
  }

  [aria-expanded="true"] .hamburger-line:nth-child(1) {
    transform: translateY(4px) rotate(45deg);
    background-color: #2C2825 !important;
  }
  [aria-expanded="true"] .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded="true"] .hamburger-line:nth-child(3) {
    transform: translateY(-4px) rotate(-45deg);
    width: 1.5rem;
    background-color: #2C2825 !important;
  }

  /* Pages without hero video should start with dark header */
  :global(.page-light) #site-header .logo-text,
  :global(.page-light) #site-header .logo-sub,
  :global(.page-light) #site-header .nav-link {
    color: #2C2825;
    text-shadow: none;
  }

  :global(.page-light) #site-header .hamburger-line {
    background-color: #2C2825;
  }
</style>
