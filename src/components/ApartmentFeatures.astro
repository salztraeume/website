---
interface Props {
  features: string[];
}

const { features } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
  {features.map((feature) => (
    <div class="flex items-center gap-2.5 py-2">
      <svg class="w-4 h-4 text-salt-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M4.5 12.75l6 6 9-13.5" />
      </svg>
      <span class="text-body-sm text-charcoal-600">{feature}</span>
    </div>
  ))}
</div>
