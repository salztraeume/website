---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Tagungsraum" description="Seminarraum und Yogaraum in Bad Saarow. Bis zu 30 Personen. Ideal für Firmenevents, Workshops und Yoga." bodyClass="page-light">
  <section class="pt-28 lg:pt-36 pb-24 section-padding bg-cream-50">
    <div class="content-width">
      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <div>
          <div class="divider-salt mb-8"></div>
          <h1 class="text-h1 font-heading text-charcoal-900 mb-4">Tagungsraum</h1>
          <p class="font-heading text-xl italic text-forest-600 mb-6">
            Raum für neue Ideen. Platz für Bewegung. Ort zum Kraftsammeln.
          </p>
          <p class="text-body text-charcoal-500 mb-8 leading-relaxed">
            Unser 50 m² großer Seminarraum am Waldrand bietet den perfekten Rahmen
            für Firmenveranstaltungen, Tagungen, Workshops und Yoga-Kurse. Nur 250 Meter
            vom See entfernt — Natur als Inspiration inklusive.
          </p>

          <!-- Quick Stats -->
          <div class="grid grid-cols-3 gap-4 mb-8">
            <div class="bg-white rounded-xl p-4 text-center shadow-warm">
              <p class="font-heading text-2xl font-semibold text-charcoal-800">50 m²</p>
              <p class="text-caption text-charcoal-400 mt-1">Seminarraum</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-warm">
              <p class="font-heading text-2xl font-semibold text-charcoal-800">30</p>
              <p class="text-caption text-charcoal-400 mt-1">Plätze (Vortrag)</p>
            </div>
            <div class="bg-white rounded-xl p-4 text-center shadow-warm">
              <p class="font-heading text-2xl font-semibold text-charcoal-800">12</p>
              <p class="text-caption text-charcoal-400 mt-1">Plätze (Yoga)</p>
            </div>
          </div>
        </div>

        <div>
          <img
            src="https://www.salztraeume-am-see.de/img/start/start1.jpg"
            alt="Tagungsraum bei Salzträume am See"
            class="rounded-2xl w-full aspect-[4/3] object-cover shadow-warm-lg"
            width="640"
            height="480"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Equipment -->
  <section class="section-padding py-20 bg-white">
    <div class="content-width">
      <div class="grid md:grid-cols-2 gap-16">
        <div>
          <h2 class="text-h3 font-heading text-charcoal-900 mb-6">Ausstattung</h2>
          <div class="grid grid-cols-2 gap-3">
            {['Tische & Stühle', 'Flipchart', 'SD-Player', 'Kühlschrank', 'Yogamatten', 'Nebenraum', 'Gäste-WC', 'Gartenfläche'].map((item) => (
              <div class="flex items-center gap-2.5 py-2">
                <svg class="w-4 h-4 text-forest-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span class="text-body-sm text-charcoal-600">{item}</span>
              </div>
            ))}
          </div>
        </div>
        <div>
          <h2 class="text-h3 font-heading text-charcoal-900 mb-6">Inklusive Extras</h2>
          <div class="grid grid-cols-2 gap-3">
            {['Fahrräder', 'Gummiboote', 'Grillausstattung', 'Feuerkorb', 'Öffentlicher Parkplatz', 'Bushaltestelle vor Ort'].map((item) => (
              <div class="flex items-center gap-2.5 py-2">
                <svg class="w-4 h-4 text-salt-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z" />
                </svg>
                <span class="text-body-sm text-charcoal-600">{item}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Combination -->
  <section class="section-padding py-16 bg-gradient-to-r from-forest-50 to-cream-50">
    <div class="content-width">
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12">
        <div class="w-16 h-16 flex-shrink-0 rounded-2xl bg-forest-200/50 flex items-center justify-center">
          <svg class="w-8 h-8 text-forest-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
          </svg>
        </div>
        <div>
          <h3 class="font-heading text-xl font-semibold text-charcoal-800 mb-2">Kombination mit Übernachtung</h3>
          <p class="text-body text-charcoal-500">
            Kombinieren Sie den Tagungsraum mit unseren Ferienwohnungen für bis zu 9 Personen.
            Ideal für mehrtägige Workshops und Team-Events.
          </p>
        </div>
        <div class="flex-shrink-0">
          <a href="/kontakt/" class="btn-primary text-sm">Anfrage senden</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
