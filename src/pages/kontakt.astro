---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kontakt & Anreise" description="Kontaktieren Sie Salzträume am See. Adresse, Telefon, E-Mail und Anfahrtsbeschreibung nach Bad Saarow." bodyClass="page-light">
  <section class="pt-28 lg:pt-36 pb-24 section-padding bg-cream-50">
    <div class="content-width">
      <div class="max-w-3xl mb-16">
        <div class="divider-salt mb-8"></div>
        <h1 class="text-h1 font-heading text-charcoal-900 mb-4">Kontakt & Anreise</h1>
        <p class="section-subtitle">
          Wir freuen uns auf Ihre Nachricht. Am besten erreichen Sie uns per E-Mail oder über das Buchungsformular.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-16">
        <!-- Contact Info -->
        <div class="space-y-8">
          <div class="bg-white rounded-2xl shadow-warm p-8">
            <h2 class="text-h3 font-heading text-charcoal-900 mb-6">Kontaktdaten</h2>
            <address class="not-italic space-y-5">
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 flex-shrink-0 rounded-xl bg-salt-100 flex items-center justify-center">
                  <svg class="w-5 h-5 text-salt-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-medium text-charcoal-800">Adresse</p>
                  <p class="text-charcoal-500">Silberberger Straße 16<br />15526 Bad Saarow</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 flex-shrink-0 rounded-xl bg-salt-100 flex items-center justify-center">
                  <svg class="w-5 h-5 text-salt-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                  </svg>
                </div>
                <div>
                  <p class="font-medium text-charcoal-800">Telefon</p>
                  <a href="tel:+4933631809869" class="text-salt-600 hover:text-salt-700 transition-colors duration-200">+49 33631 809869</a>
                  <p class="text-caption text-charcoal-400 mt-0.5">Mo–Fr 10–12 & 14–17 Uhr</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 flex-shrink-0 rounded-xl bg-salt-100 flex items-center justify-center">
                  <svg class="w-5 h-5 text-salt-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <p class="font-medium text-charcoal-800">E-Mail</p>
                  <a href="mailto:hej@salztraeume-am-see.de" class="text-salt-600 hover:text-salt-700 transition-colors duration-200">hej@salztraeume-am-see.de</a>
                </div>
              </div>
            </address>
          </div>

          <!-- Anreise -->
          <div class="bg-white rounded-2xl shadow-warm p-8">
            <h2 class="text-h3 font-heading text-charcoal-900 mb-6">Anreise</h2>
            <div class="space-y-6">
              <div>
                <h3 class="font-heading text-lg font-semibold text-charcoal-800 mb-2 flex items-center gap-2">
                  <svg class="w-5 h-5 text-charcoal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.142-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 00-10.026 0 1.106 1.106 0 00-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                  </svg>
                  Mit dem Auto
                </h3>
                <p class="text-body-sm text-charcoal-500">
                  Ca. 45 Minuten von Berlin. 4 kostenlose Parkplätze direkt am Haus.
                </p>
              </div>
              <div>
                <h3 class="font-heading text-lg font-semibold text-charcoal-800 mb-2 flex items-center gap-2">
                  <svg class="w-5 h-5 text-charcoal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21" />
                  </svg>
                  Mit der Bahn
                </h3>
                <p class="text-body-sm text-charcoal-500">
                  RB35 nach Fürstenwalde, dann Bus 430/431 nach Bad Saarow.
                  Bushaltestelle direkt vor der Tür.
                </p>
              </div>
              <div>
                <h3 class="font-heading text-lg font-semibold text-charcoal-800 mb-2 flex items-center gap-2">
                  <svg class="w-5 h-5 text-charcoal-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                  </svg>
                  Vor Ort
                </h3>
                <p class="text-body-sm text-charcoal-500">
                  Am Haupteingang befindet sich links eine kleine Klingel.
                  Bitte teilen Sie uns Ihre Ankunftszeit einen Tag vorher mit.
                  Ankunft nach 20 Uhr bitte vorab absprechen.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="space-y-6">
          <div class="bg-white rounded-2xl shadow-warm overflow-hidden">
            <div class="aspect-square lg:aspect-[4/5]">
              <iframe
                src="https://www.openstreetmap.org/export/embed.html?bbox=14.0495%2C52.2855%2C14.0695%2C52.2955&layer=mapnik&marker=52.2905%2C14.0595"
                class="w-full h-full border-0"
                loading="lazy"
                title="Standort Salzträume am See auf der Karte"
              ></iframe>
            </div>
            <div class="p-4 text-center">
              <a
                href="https://www.openstreetmap.org/?mlat=52.2905&mlon=14.0595#map=16/52.2905/14.0595"
                target="_blank"
                rel="noopener noreferrer"
                class="text-body-sm text-salt-600 hover:text-salt-700 transition-colors duration-200"
              >
                Größere Karte öffnen &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
