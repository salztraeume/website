---
layout: master
title: Schmetterling. Zwischen Wald&See.
---
include partials/mixins
include calendar

mixin Bewertungenen
    a(target="_blank", href="https://www.airbnb.de/rooms/3956514#reviews") Bewertungen


extends flat_template

block rating-mobile
    +Bewertungenen()

block rating-large
    +Bewertungenen()

block icon
    img(src="img/schmetter.jpg", width="100px" alt="Wohnung Schmetterling")

block flat-title
    span Schmetterling. Zwischen Wald&amp;See.

block header-unterkunft
    span Ganze Unterkunft
block header-anzahl
    span 3
block header-schlafzimmer
    span 1
block header-betten
    span 2

block carousel
    +carousel()
        .item.active
            img(alt="Schmetterling", src='/img/schmetterling/schmetter1.jpg')
            .carousel-caption
                | Wohnküche
        .item
            img(alt="Schmetterling", src='/img/schmetterling/schmetter2.jpg')
            .carousel-caption
                | Wohnküche
        .item
            img(alt="Schmetterling", src='/img/schmetterling/schmetter3.jpg')
            .carousel-caption
                | Wohnküche
        .item
            img(alt="Schmetterling", src='/img/schmetterling/schmetter4.jpg')
            .carousel-caption
                | Wohnküche
        .item
            img(alt="Schmetterling", src='/img/schmetterling/schmetter5.jpg')
            .carousel-caption
                | Schlafzimmer
        .item
            img(alt="Schmetterling", src='/img/schmetterling/schmetter6.jpg')
            .carousel-caption
                | Schlafzimmer
        .item
            img(alt="Schmetterling", src='/img/schmetterling/schmetter7.jpg')
            .carousel-caption
                | Schlafzimmer
        .item
            img(alt="Schmetterling", src='/img/schmetterling/schmetter8.jpg')
            .carousel-caption
                | Bad
        .item
            img(alt="Schmetterling", src='/img/schmetterling/schmetter9.jpg')
            .carousel-caption
                | Bad


block unterkunft
    div.col-sm-6
        +keyAndStrongValue('Art der Unterkunft', 'Wohnung')
        +keyAndStrongValue('Unterkunft für', '3')
        +keyAndStrongValue('Schlafzimmer', '1')
        +keyAndStrongValue('Badezimmer', '1')

    div.col-sm-6
        +keyAndStrongValue('Betten', '2')
        +keyAndStrongValue('Check-In', '14:00')
        +keyAndStrongValue('Check-Out', '12:00')

block ausstattung
    div.col-xs-6
        +as('flaticon-fork', 'Küche', 'Küche mit Kühlschrank, Herd, Spühlmaschine sowie Kochutensilien')
        +as('flaticon-wifi93', 'Wi-Fi')
        +as('flaticon-widescreen', 'TV', 'Fernseher mit Kabelanschluss')
        +as('flaticon-bathroom13', 'Wesentliches', 'ettwäsche, Handtücher, Seife, Haartrockner, Toilettenpapier')

    div.col-xs-6
        +as('flaticon-oven4', 'Backofen', 'Cerankochfeld, Backofen und Mikrowelle')
        +as('flaticon-parking19', 'Parkplatz', 'kostenloser Parkplatz auf dem Grundstück')
        +as(null, 'Familien-/kinderfreundlich')

block preise
    div.col-md-6
        +keyAndStrongValue('bis zu 2 Personen', '50 €')
        +keyAndStrongValue('pro weitere Person', '15 €')
        +keyAndStrongValue('Reinigungsgebühr', '30 €')
        +keyAndStrongValue('Stornierung', 'flexibel')
        
    div.col-md-6
        +keyAndStrongValue('Jugendliche bis 17 Jahre', '10 €')
        +keyAndStrongValue('Kinder bis 9 Jahre', '5 €')
        +keyAndStrongValue('Kinder bis 4 Jahre', 'kostenlos')
        +keyAndStrongValue('Mindestaufenthalt', '2 Nächte')

block beschreibung
    include:markdown ./details-schmetterling.md

block calender
    +calendar('SL')