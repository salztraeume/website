---
layout: master
title: Eichhörnchen. Zwischen Wald&See.
---
include partials/mixins
include calendar

mixin Bewertungenen
    a(target="_blank", href="https://www.airbnb.de/rooms/3955587#reviews") Bewertungenen

div.row
    div.col-md-3.text-center
        img(src="img/eichh.jpg", width="100px" alt="Wohnung Eichhörnchen")

        div.rating.hidden-md.hidden-lg
            +Bewertungenen()
    div.col-md-9

        h1.overflow.h3.text-center-sm
            | Eichhörnchen. Zwischen Wald&amp;See.

        div.row.row-condensed.text-muted.text-center
            div.col-xs-3: i.icon.icon2x.flaticon-home63
            div.col-xs-3: i.icon.icon2x.flaticon-group12
            div.col-xs-3: i.icon.icon2x.flaticon-opened37
            div.col-xs-3: i.icon.icon2x.flaticon-bed29

div.row
    div.col-md-3.text-muted.text-center.hide-xs
        div.rating.hidden-xs.hidden-sm
            +Bewertungenen()

    div.col-md-9
        div.row.row-condensed.text-muted.text-center
            div.col-xs-3 Ganze Unterkunft
            div.col-xs-3 4 Gäste
            div.col-xs-3 1 Schlafzimmer
            div.col-xs-3 2 Betten

+carousel()
  .item.active
    img(alt="Eichhörnchen", src='https://a2.muscache.com/ic/pictures/51313166/dbc400f8_original.jpg?interpolation=lanczos-none&size=xx_large&output-format=jpg&output-quality=70')
    .carousel-caption
      | Ferienwohnung Eichhörnchen
  .item
    img(alt="Schlafzimmer", src='https://a1.muscache.com/ic/pictures/49760985/f594154e_original.jpg?interpolation=lanczos-none&size=x_large&output-format=progressive-jpeg&output-quality=70')
    .carousel-caption
      | Schlafzimmer
  .item
    img(alt="Schlafzimmer", src='https://a0.muscache.com/ic/pictures/49760927/ea6d8511_original.jpg?interpolation=lanczos-none&size=x_large&output-format=progressive-jpeg&output-quality=70')
    .carousel-caption
      | Schlafzimmer
  .item
    img(alt="Küche", src='https://a1.muscache.com/ic/pictures/49761054/149e822b_original.jpg?interpolation=lanczos-none&size=x_large&output-format=progressive-jpeg&output-quality=70')
    .carousel-caption
      | Küche
  .item
    img(alt="Küche", src='https://a2.muscache.com/ic/pictures/49761132/86968bf4_original.jpg?interpolation=lanczos-none&size=x_large&output-format=progressive-jpeg&output-quality=70')
    .carousel-caption
      | Küche
  .item
    img(alt="Küchentisch", src='https://a1.muscache.com/ic/pictures/56028445/40556437_original.jpg?interpolation=lanczos-none&size=x_large&output-format=progressive-jpeg&output-quality=70')
    .carousel-caption
      | Küchentisch
  .item
    img(alt="Badezimmer", src='https://a2.muscache.com/ic/pictures/49760755/fac359f1_original.jpg?interpolation=lanczos-none&size=x_large&output-format=progressive-jpeg&output-quality=70')
    .carousel-caption
      | Badezimmer

hr

div.row
    div.col-sm-3
        div.text-muted Die Unterkunft

    div.col-sm-9
        div.row.bigger-line
            div.col-sm-6
                +keyAndStrongValue('Art der Unterkunft', 'Wohnung')
                +keyAndStrongValue('Unterkunft für', '4')
                +keyAndStrongValue('Schlafzimmer', '1')
                +keyAndStrongValue('Badezimmer', '1')

            div.col-sm-6
                +keyAndStrongValue('Betten', '2')
                +keyAndStrongValue('Check-In', '14:00')
                +keyAndStrongValue('Check-Out', '12:00')

hr

div.row
    div.col-md-3.text-muted
        | Ausstattung

    div.col-md-9
        div.row
            div.col-xs-6
                +as('flaticon-fork', 'Küche', 'Küche mit Kühlschrank, Herd, Spühlmaschine sowie Kochutensilien')
                +as('flaticon-wifi93', 'Wi-Fi')
                +as('flaticon-widescreen', 'TV', 'Fernseher mit Kabelanschluss')
                +as('flaticon-bathtub7', 'Badewanne', '2 Waschbecken, Eckbadewanne und Dusche')

            div.col-xs-6
                +as('flaticon-bathroom13', 'Wesentliches', 'ettwäsche, Handtücher, Seife, Haartrockner, Toilettenpapier')
                +as('flaticon-oven4', 'Backofen', 'Cerankochfeld, Backofen und Mikrowelle')
                +as('flaticon-parking19', 'Parkplatz', 'kostenloser Parkplatz auf dem Grundstück')
                +as(null, 'Familien-/kinderfreundlich')

hr

div.row
    div.col-md-3.text-muted
        | Preise

    div.col-md-9
        div.row.bigger-line
            div.col-md-6
                +keyAndStrongValue('bis zu 2 Personen', '55 €')
                +keyAndStrongValue('pro weitere Person', '15 €')
                +keyAndStrongValue('Reinigungsgebühr', '30 €')
                +keyAndStrongValue('Stornierung', 'flexibel')
                
            div.col-md-6
                +keyAndStrongValue('Jugendliche bis 17 Jahre', '10 €')
                +keyAndStrongValue('Kinder bis 9 Jahre', '5 €')
                +keyAndStrongValue('Kinder bis 4 Jahre', 'kostenlos')
                +keyAndStrongValue('Mindestaufenthalt', '2 Nächte')

hr

div.row
    div.col-md-3.text-muted
        | Beschreibung

    div.col-md-9
        div.expandable
            include:markdown ./eichhoernchen-details.md

hr

div.row
    div.col-md-3.text-muted
        | Hausregeln

    div.col-md-9
        div.expandable
            include:markdown ./eichhoernchen-regeln.md

hr

