extends flat_template

block flat-title
    span Apartment Eichhörnchen. Direkt zwischen Wald &amp; See.

block carousel
    +carousel()
      .item.active
        img(alt="Eichhörnchen", src='/img/eichhoernchen/eich1.jpg')
        .carousel-caption
          | Wohnküche
      .item
        img(alt="Eichhörnchen", src='/img/eichhoernchen/eich2.jpg')
        .carousel-caption
          | Wohnküche
      .item
        img(alt="Eichhörnchen", src='/img/eichhoernchen/eich3.jpg')
        .carousel-caption
          | Wohnküche
      .item
        img(alt="Eichhörnchen", src='/img/eichhoernchen/eich4.jpg')
        .carousel-caption
          | Wohnküche
      .item
        img(alt="Eichhörnchen", src='/img/eichhoernchen/eich5.jpg')
        .carousel-caption
          | Schlafzimmer
      .item
        img(alt="Eichhörnchen", src='/img/eichhoernchen/eich6.jpg')
        .carousel-caption
          | Schlafzimmer
      .item
        img(alt="Eichhörnchen", src='/img/eichhoernchen/eich7.jpg')
        .carousel-caption
          | Bad
      .item
        img(alt="Eichhörnchen", src='/img/eichhoernchen/eich8.jpg')
        .carousel-caption
          | Flur

block unterkunft
    div.col-sm-6
        +keyAndStrongValue('Art der Unterkunft', 'Wohnung')
        +keyAndStrongValue('Unterkunft für', '4')
        +keyAndStrongValue('Schlafzimmer', '1')
        +keyAndStrongValue('Badezimmer', '1')

    div.col-sm-6
        +keyAndStrongValue('Betten', '2')
        +checkInOut()

block ausstattung
    div.col-xs-6
        +as('flaticon-fork', 'Küche', 'Küche mit Kühlschrank, Herd, Spühlmaschine sowie Kochutensilien')
        +as('flaticon-wifi93', 'Wi-Fi')
        +as('flaticon-widescreen', 'TV', 'Fernseher mit Kabelanschluss')
        +as('flaticon-bathtub7', 'Badewanne', '2 Waschbecken, Eckbadewanne und Dusche')

    div.col-xs-6
        +as('flaticon-bathroom13', 'Wesentliches', 'ettwäsche, Handtücher, Seife, Haartrockner, Toilettenpapier')
        +as('flaticon-oven4', 'Backofen', 'Cerankochfeld, Backofen und Mikrowelle')
        +as('flaticon-parking19', 'Parkplatz', 'kostenloser Parkplatz auf dem Grundstück')
        +as(null, 'Familien-/kinderfreundlich')

block preise
    div.col-md-6
        +keyAndStrongValue('bis zu 2 Personen', '55 €')
        +keyAndStrongValue('pro weitere Person', '15 €')
        +keyAndStrongValue('Reinigungsgebühr', '30 €')
        +keyAndStrongValue('Stornierung', 'flexibel')
        
    div.col-md-6
        +keyAndStrongValue('Jugendliche bis 17 Jahre', '10 €')
        +keyAndStrongValue('Kinder bis 9 Jahre', '5 €')
        +keyAndStrongValue('Kinder bis 4 Jahre', 'kostenlos')
        +keyAndStrongValue('Mindestaufenthalt', '2 Nächte')

block beschreibung
    include:markdown ./details-eichhoernchen.md

block regeln
    include:markdown ./regeln-eichhoernchen.md

block calender
    +calendar('EH')

block buchen
    +buchen('EH')