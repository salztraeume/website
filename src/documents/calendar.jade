mixin calendar(flat)
    div.row
        if flat == null
            div(style="padding: 20px")
                label Wähle Wohnungen aus, um die Belegung im Kalender anzuzeigen
            
        if flat == null
            div.col-lg-8.col-md-12.flat-icon-container 
                div
                    label
                        div.icon.SL
                        div.icon-label Schmetterling
                            input.filter-SL(type="checkbox")
                div
                    label
                        div.icon.EH
                        div.icon-label Eichhörnchen
                            input.filter-EH(type="checkbox")
                div
                    label
                        div.icon.F1
                        div.icon-label Fuchs 1
                            input.filter-F1(type="checkbox")
                div
                    label
                        div.icon.F2
                        div.icon-label Fuchs 2
                            input.filter-F2(type="checkbox")
                div
                    label
                        div.icon.F3
                        div.icon-label Fuchs 3
                            input.filter-F3(type="checkbox")

        div.col-lg-4.col-md-12.cal-controls
            div.cal-date-control
                button.btn.btn-primary.prev.glyphicon.glyphicon-chevron-left
                input.date(readonly)
                button.btn.btn-primary.next.glyphicon.glyphicon-chevron-right

    table.booking-calendar(data-flat=flat)
        tr
            each day in ['', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So']
                th=day
        each week in [1,2,3,4,5,6]
            tr(class='w'+week)
                th
                    if flat != null
                        .table-header
                    else
                        .table-header.icon.SL
                        .table-header.icon.EH
                        .table-header.icon.F1
                        .table-header.icon.F2
                        .table-header.icon.F3

                each day in [0,1,2,3,4,5,6]
                    td(class=['day','w'+week, 'd'+day])