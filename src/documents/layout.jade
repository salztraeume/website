doctype html
html(lang="en")
  head
    meta(harset="utf-8")
    meta(http-equiv="X-UA-Compatible", content="IE=edge")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Bootstrap 101 Template

    // Bootstrap (this a HTML comment)
    link(href="bootstrap/bootstrap.css", rel="stylesheet")

    //- You can embedd HTML in jade, but don't use indentation!
    
    <!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/libs/html5shiv/3.7.0/html5shiv.js"></script>
    <script src="https://oss.maxcdn.com/libs/respond.js/1.4.2/respond.min.js"></script>
    <![endif]-->

  body
    //- in another file use `extends layout` to fill this block with live ;)
    block content

    // (necessary for Bootstrap's JavaScript plugins) 
    script(src="https://ajax.googleapis.com/ajax/libs/jquery/1.11.0/jquery.min.js")
    
    // Include all compiled plugins (below), or include individual files as needed 
    script(src="js/bootstrap.min.js")

    //- add docpad live reload (this is a jade comment, not a HTML comment)
    != getBlock('scripts').toHTML()
