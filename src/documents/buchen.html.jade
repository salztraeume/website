---
layout: master
title: Belegungskalender für unsere Ferienwohnungen
keywords: reservierungsanfrage, anfragen, kalender
description: Hier finden Sie unseren Belegungskalender für die Ferienwohnungen. Über das Formular können Sie eine unverbindliche Anfrage stellen.
---
include partials/calendar

div.calendar
    +calendarControls()
    div.multi-calendar.row
        +bookingCalendar()

form#booking-form.conainter.booking(onsubmit="return false;")

    h3#header-title Reservierungsanfrage

    div.form-group
        label.validation.arrival.control-label(for="b_arrival")
        label.validation.departure.control-label(for="b_departure")
        div.input-daterange.input-group#datepicker
            input#b_arrival.form-control(type="text", required, name="start", placeholder="Ankunft")
            span.input-group-addon bis
            input#b_departure.form-control(type="text", required, name="end", placeholder="Abreise")
            span.input-group-addon in
            select#b_flat.form-control.ignore-error
                option(data-max="2", value="Schmetterling", data-location='SL') Schmetterling
                option(data-max="3", value="Eichhoernchen", data-location='EH') Eichhörnchen
                option(data-max="8", value="Fuchs", data-location='FS') Fuchs
                option(data-max="4", value="Schwan", data-location="SW") Schwan

    div.form-group.min-stay
        label.control-label.min-stay(for="b_departure") In Zeitraum beträgt der Mindestaufenthalt <span id="min-stay-value">?</span> Nächte

    div.form-group
        div.input-group#guests_control
            input#b_guests_adult.input.form-control(type="number", min="0", data-price="15", data-fee="2", placeholder="Erw. ab 18 Jahre", data-toggle="tooltip", data-placement="top", title="ab 18 Jahre")
            span.input-group-addon
            input#b_guests_teens.input.form-control(type="number", min="0", data-price="15", data-fee="1", placeholder="Kinder 13-17 Jahre", data-toggle="tooltip", data-placement="top", title="13-17 Jahre")
            span.input-group-addon
            input#b_guests_children2.input.form-control(type="number", min="0", data-price="10", data-fee="1", placeholder="Kinder 10-12 Jahre", data-toggle="tooltip", data-placement="top", title="10-12 Jahre")
            span.input-group-addon
            input#b_guests_children1.input.form-control(type="number", min="0", data-price="5", data-fee="0", placeholder="Kinder 3-9 Jahre", data-toggle="tooltip", data-placement="top", title="3-9 Jahre")
            span.input-group-addon
            input#b_guests_children_free.input.form-control(type="number", min="0", data-price="0", data-fee="0", placeholder="Kinder bis 2 Jahre", data-toggle="tooltip", data-placement="top", title="bis 2 Jahre")
        
    div.form-group.guests-size
        label.size-overflow.control-label(for="b_guests_total") Wohnung bietet evtl. nicht genug Schlafplätze! Eine Anfrage ist dennoch möglich.
        label.size-underflow.control-label(for="b_guests_total") Es muss für mindestens eine Person gebucht werden
        div.input-group
            span.input-group-addon Anzahl angefragt:
            input#b_guests_total.form-control(type="text", readonly, value="0")
            span.input-group-addon Anzahl verfügbar:
            input#flat_size.form-control(type="text", readonly, value="3")

    div.form-group.calculation
        table.table.table-striped.table-hover.table-condensed
            tr
                th.left-col Grundpreis:
                td#price-base
             tr.price-extra-saison
                th Hauptsaison:
                td#price-extra-saison
            tr
                th weitere Personen:
                td#price-extra-person
            tr
                th Servicegebühr:
                td#price-clean
            tr
                th Summe:
                td#price-sum
            tr
                th
                    | zzgl. Kurtaxe
                    //-span.glyphicon.glyphicon-info-sign
                    |:
                td#price-fee


    div.form-group
        div.form-inline
            div.form-group
                label.validation.name.control-label(for="b_gender")
                label.radio-inline
                    input(type="radio" name="b_gender" id="b_gender_f" required value="f")
                    | Frau
                label.radio-inline
                    input(type="radio" name="b_gender" id="b_gender_m" required value="m")
                    | Herr
            span=" "
            div.form-group
                label.validation.name.control-label(for="b_firstname")
                input#b_firstname.form-control(type="text", required, placeholder="Vorname", size=20)
                label.validation.name.control-label(for="b_name")
                input#b_name.form-control(type="text", required, placeholder="Nachname", size=20)
            span=" "
            div.form-group
                div.form-inline
                    span Ich möchte geduzt werden
                    span=" "
                    input#b_tv-distinction(type="checkbox" name="b_tv-distinction")

    div.form-group
        label.validation.email.control-label(for="b_email")
        input#b_email.form-control(type="email", required, placeholder="E-Mail")

    div.form-group
        span.control-label Kopie an mich mitschicken:
        span=" "
        input#b_send_email(type="checkbox", checked)

    div.form-group

        label.validation.phone.control-label(for="b_phone")
        input#b_phone.form-control(type="tel", required, placeholder="Telefon")

    div.form-group
        label.control-label(for="b_code")
        input#b_code.form-control(type="text", placeholder="Gutscheincode")

    div.form-group
        textarea#b_note.form-control(rows="2", placeholder="Bemerkungen")

    div.form-group
        label.validation.found.control-label(for="b_found")
        select#b_found.form-control(required)
            option(value='' disabled, selected) Gefunden über ...
            option(value="suchmaschine") Suchmaschine
            option(value="airbnb") Airbnb
            option(value="fewo") FeWo-direkt
            option(value="vorort-schild") Vor-Ort-Außenschild
            option(value="flyer") Flyer
            option(value="empfehlung") Empfehlung
            option(value="sonstiges") Sonstiges

    div.form-group
        span.control-label Ich habe die Datenschutzerklärung gelesen und bin damit einverstanden:
        span=" "
        input#b_privacy_policy(type="checkbox" required)

    div.form-group
        button#b_submit.btn.btn-primary Unverbindlich anfragen

div#reservation

+loadCalendarEvents()
