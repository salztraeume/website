mixin calendar(flat, month, columns)
    +calendarControls(flat)
    +bookingCalendar(flat, month, columns)

mixin loadCalendarEvents
    script.
        var url = "https://cal-aggregator.awspace.de/items.js"
        if (window.location.hostname === 'localhost') {
            url = 'http://localhost:5002/items.js'
        }
        var script = document.createElement('script')
        script.src = url
        script.onload = function() {window.initializeCalendar()}
        document.getElementsByTagName('head')[0].appendChild(script)

mixin calendarControls(flat)
    div.row
        if flat == null
            div(style="padding: 20px")
                label Wähle Wohnungen aus, um die Belegung im Kalender anzuzeigen

        if flat == null
            div.col-lg-8.col-md-12.flat-icon-container
                div
                    label.checker
                        input.checker.filter-SL(type="checkbox")
                        span
                        div.icon.SL
                        div.icon-label Schmetterling
                div
                    label.checker
                        input.checker.filter-EH(type="checkbox")
                        span
                        div.icon.EH
                        div.icon-label Eichhörnchen
                div
                    label.checker
                        input.checker.filter-FS(type="checkbox")
                        span
                        div.icon.FS
                        div.icon-label Fuchs

                div
                    label.checker
                        input.checker.filter-SW(type="checkbox")
                        span
                        div.icon.SW
                        div.icon-label Schwan



        div.col-lg-4.col-md-12.cal-controls
            div.cal-date-control
                button.btn.btn-primary.prev.glyphicon.glyphicon-chevron-left
                input.date(readonly)
                button.btn.btn-primary.next.glyphicon.glyphicon-chevron-right

mixin bookingCalendar(flat, month, columns)
    if month != null
        - classes = ['col-md-'+columns]
    else
        - classes = ['col-xs-12']

    div.ajax-spinner
        span.glyphicon.glyphicon-refresh.spinning
        | Daten werden geladen

    table.booking-calendar(data-flat=flat, data-month=month, class=classes)
        thead
            if month != null
                tr
                    th.month-name(colspan="8", data-month=month) MONATSNAME

            tr
                each day in ['', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa', 'So']
                    th=day

        tbody
            each week in [1,2,3,4,5,6]
                tr(class='w'+week)
                    th
                        if flat != null && month == null
                            .table-header
                        if flat == null
                            .table-header.icon.SL
                            .table-header.icon.EH
                            .table-header.icon.FS
                            .table-header.icon.SW

                    each day in [0,1,2,3,4,5,6]
                        td(class=['day','w'+week, 'd'+day])
