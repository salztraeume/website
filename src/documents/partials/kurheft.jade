        span.input-group-addon=' '
        input.form-control(type="text" name="b_lastname4" placeholder="Familienname")
        span.invisible.input-group-addon=' '
        input.invisible.form-control(type="text" name="b_arrival4" maxlength="8" placeholder="Ankunft (TT.MM.JJ)" disabled)
        span.invisible.input-group-addon=' '
        input.invisible.form-control(type="text" name="b_departure4" maxlength="8" placeholder="Abreise (TT.MM.JJ)" disabled)
    br

    span 5. Familienmitglied
    div.input-group
        input.form-control(type="text" name="b_firstname5" placeholder="Vorname")
        span.input-group-addon=' '
        input.form-control(type="text" name="b_lastname5" placeholder="Familienname")
        span.invisible.input-group-addon=' '
        input.invisible.form-control(type="text" name="b_arrival5" maxlength="8" placeholder="Ankunft (TT.MM.JJ)" disabled)
        span.invisible.input-group-addon=' '
        input.invisible.form-control(type="text" name="b_departure5" maxlength="8" placeholder="Abreise (TT.MM.JJ)" disabled)
    br